<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Slider?>
<?import javafx.geometry.Insets?>
    

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
fx:controller="com.datnamedoo.www.MenuController" fx:id = "mainMenu">
    <Pane>

        <Canvas fx:id="demoReplay" width="800" height="800" />
                  
    </Pane>
    



    <VBox spacing="15" alignment="CENTER" 
         style="-fx-background-color: #7a5fb848; -fx-padding: 0 0 0 0" prefHeight="800" minHeight="600">

         <Text text="Game Of Life" fill="#48ff00" stroke="#0c0b0b" strokeWidth="2.0" >
            <font>
                <Font name="System Bold" size="100"/>
            </font>    
        </Text>

        <Text text="By: datnamedoo" fill="#f4f8f3" stroke="#0c0b0b" strokeWidth="1.0" >
            <font>
                <Font name="System Bold" size="40"/>
            </font>    
        </Text>

        <Button fx:id="launchGame" text="Launch" 
        prefWidth="400" prefHeight="100" maxHeight="100"
        defaultButton="false" onAction="#startGame"
        style="-fx-background-color: #57b10eb0; -fx-font-size: 25"/>

        <Button fx:id="settings" text="Settings" 
        prefWidth="400" prefHeight="100" maxHeight="100"
        defaultButton="false" onAction="#showSettings"
        style="-fx-background-color: #a7e0b1b0; -fx-font-size: 25;"/>

        <Button fx:id="exitButton" text="Exit" 
        prefWidth="400" prefHeight="100" maxHeight="100"
        defaultButton="false" onAction="#exitMainMenu"
        style="-fx-background-color: #ee2d0be1; -fx-font-size: 25;"/>


    </VBox>
    

    <VBox fx:id="settingsContainer" spacing="5" alignment="TOP_CENTER" style="-fx-background-color: #48464ea6;" 
    prefHeight="600" maxHeight="600" prefWidth="600" maxWidth="600" visible="false">
    

    <VBox spacing="1" alignment="TOP_RIGHT" style="-fx-background-color: #00000000;" 
    prefHeight="20" prefWidth="800" >
    <Button fx:id="closeSettingsButton" text="close" 
        prefWidth="100" prefHeight="40" maxHeight="20"
        defaultButton="false" onAction="#closeSettings" 
        style="-fx-background-color: #ee2d0ba6; -fx-font-size: 15;"/>
    </VBox>



    <VBox spacing="1" alignment="TOP_LEFT" style="-fx-background-color: #00000000;" 
    prefHeight="600" prefWidth="800" > 
    <padding>
        <Insets left="30"/>
    </padding>
        
    <Text text="Settings" fill="#f4f8a6" stroke="#0c0b0b" strokeWidth="0.5" >     
            <font>
                <Font name="System Bold" size="40"/>
            </font>        
    </Text>


    <HBox spacing="5" alignment="CENTER_LEFT" style="-fx-background-color: #00000000;" 
    prefHeight="10" prefWidth="10" > 
    <Text text="Grid Dimensions-" fill="#f4f5ed" stroke="#0c0b0b" strokeWidth="0.5" >     
            <font>
                <Font name="System Bold" size="30"/>
            </font>        
    </Text>
    <ComboBox fx:id="dimensionsSelection" prefHeight="35" prefWidth="150" style="-fx-background-color: #15bdbda8; -fx-border-color: #15bdbda8;"
      onAction="#newDimensionSelection" promptText="2048x2048" />

    </HBox>

    <HBox spacing="5" alignment="CENTER_LEFT" style="-fx-background-color: #00000000;" 
    prefHeight="10" prefWidth="10" > 
    <Text text="System Threading-" fill="#f4f5ed" stroke="#0c0b0b" strokeWidth="0.5" >     
            <font>
                <Font name="System Bold" size="30"/>
            </font>        
    </Text>
    <ComboBox fx:id="threadingSelection" prefHeight="35" prefWidth="175" style="-fx-background-color: #15bdbda8; -fx-border-color: #15bdbda8;"
      onAction="#newThreadingSelection" promptText="MULTITHREADED" />

    </HBox>
    


    </VBox>





    <VBox spacing="5" alignment="TOP_LEFT" style="-fx-background-color: #00000000;" 
    prefHeight="600" prefWidth="800" > 
   
    <padding>
        <Insets left="30"/>
    </padding>
        

    <Text text="Controls: " fill="#ffff1f" stroke="#0c0b0b" strokeWidth="0.5" >     
        <font>
            <Font name="System Bold" size="40"/>
        </font>       
    </Text>
    
    <Text text="Pan Camera - RIGHT CLICK" fill="#ffff1f" stroke="#0c0b0b" strokeWidth="0.5" >     
        <font>
            <Font name="System Bold" size="30"/>
        </font>       
    </Text>

    <Text text="Zoom Camera - MouseWheel/Q/E" fill="#ffff1f" stroke="#0c0b0b" strokeWidth="0.5" >     
        <font>
            <Font name="System Bold" size="30"/>
        </font>       
    </Text>

    <Text text="Quick Restart - R" fill="#ffff1f" stroke="#0c0b0b" strokeWidth="0.5" >     
        <font>
            <Font name="System Bold" size="30"/>
        </font>       
    </Text>

    <Text text="Quick Pause - SPACE" fill="#ffff1f" stroke="#0c0b0b" strokeWidth="0.5" >     
        <font>
            <Font name="System Bold" size="30"/>
        </font>       
    </Text>
    
    
    </VBox>
        




    </VBox>
   
</StackPane>



