<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Slider?>
<?import javafx.geometry.Insets?>


<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
fx:controller="com.datnamedoo.www.PrimaryController" spacing="0" alignment="TOP_CENTER"
style="-fx-background-color: #080808"  fx:id = "mainContainer">
      <HBox spacing="15" alignment="CENTER"
         style="-fx-background-color: #852c2c" prefHeight="40" minHeight="40">



      <Label text="Speed [ms]" textFill="#bbadaddc" > 

               <font>
                  <Font name="System Bold" size="15"/>
               </font>  
      </Label>

      <Slider fx:id="speedSlider"
               min="0"
               max="250"
               value="75"
               prefWidth="250"
               maxHeight="10"
               showTickLabels="false"
               showTickMarks="false"
               majorTickUnit="25"
               minorTickCount="5"
               snapToTicks="true"
               style="-fx-background-color: #e67b7b00"/>
      
      <ComboBox fx:id="paletteSelectionBox" maxHeight="25" style="-fx-background-color: #c4a1a1; -fx-border-color: #c4a1a1;"
      onAction="#handleNewPaletteSelection" promptText="DEFAULT" />

      <Button fx:id="testButtonForGrid" text="Restart" 
      prefWidth="75" prefHeight="25" maxHeight="25"
      defaultButton="false" onAction="#testDrawGrid"
      style="-fx-background-color: #c08847"/>

      <Button fx:id="systemPauseButton" text="Pause" 
      prefWidth="75" prefHeight="25" maxHeight="25"
      defaultButton="false" onAction="#pauseCurrentGame"
      style="-fx-background-color: #c4a1a1"/>



      <Button fx:id="systemExitButton" text="Close" 
      prefWidth="60" prefHeight="25" maxHeight="25"
      defaultButton="false" onAction="#fullSystemExit"
      style="-fx-background-color: #c47777" />

      

      </HBox>
      
<StackPane fx:id="gameContainer" VBox.vgrow="NEVER">

<Pane>

   <Canvas fx:id="screenOutput" width="1024" height="1024" />
                  
</Pane>

</StackPane>
</VBox>
